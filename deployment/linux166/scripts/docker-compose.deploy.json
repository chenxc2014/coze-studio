{
  "name": "coze-studio",
  "x-env-file": [
    ".env"
  ],
  "services": {
    "mysql": {
      "image": "mysql@sha256:679e7e924f38a3cbb62a3d7df32924b83f7321a602d3f9f967c01b3df18495d6",
      "container_name": "coze-mysql",
      "restart": "unless-stopped",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${MYSQL_ROOT_PASSWORD:-root}",
        "MYSQL_DATABASE": "${MYSQL_DATABASE:-opencoze}",
        "MYSQL_USER": "${MYSQL_USER:-coze}",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD:-coze123}"
      },
      "env_file": [
        ".env"
      ],
      "volumes": [
        "/home/coze/data/mysql:/var/lib/mysql:z",
        "/home/coze/src/coze-studio/docker/volumes/mysql/schema.sql:/docker-entrypoint-initdb.d/init.sql:z",
        "/home/coze/src/coze-studio/docker/atlas/opencoze_latest_schema.hcl:/opencoze_latest_schema.hcl:ro,z"
      ],
      "entrypoint": [
        "bash",
        "-c",
        "/usr/local/bin/docker-entrypoint.sh mysqld --binlog-expire-logs-seconds=259200 --max-binlog-size=104857600 --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci &\nMYSQL_PID=$$!\n\necho 'Waiting for MySQL to start...'\nuntil mysqladmin ping -h localhost -u root -p$${MYSQL_ROOT_PASSWORD} --silent 2>/dev/null; do\n  echo 'MySQL is starting...'\n  sleep 2\ndone\n\necho 'Waiting for workflow_version table to exist...'\nwhile true; do\n  if mysql -h localhost -u root -p$${MYSQL_ROOT_PASSWORD} $${MYSQL_DATABASE} -e \"SHOW TABLES LIKE 'workflow_version';\" 2>/dev/null | grep -q \"workflow_version\"; then\n    echo 'Found workflow_version table, continuing...'\n    break\n  else\n    echo 'workflow_version table not found, retrying in 2 seconds...'\n    sleep 2\n  fi\ndone\n\necho 'MySQL is ready, installing Atlas CLI...'\n\nif ! command -v atlas >/dev/null 2>&1; then\n  echo 'Installing Atlas CLI...'\n  curl -sSf https://atlasgo.sh | sh -s -- -y --community\n  export PATH=$$PATH:/root/.local/bin\nelse\n  echo 'Atlas CLI already installed'\nfi\n\nif [ -f '/opencoze_latest_schema.hcl' ]; then\n  echo 'Running Atlas migrations...'\n  ATLAS_URL=\"mysql://$${MYSQL_USER}:$${MYSQL_PASSWORD}@localhost:3306/$${MYSQL_DATABASE}\"\n  atlas schema apply -u \"$ATLAS_URL\" --to \"file:///opencoze_latest_schema.hcl\" --exclude \"atlas_schema_revisions,table_*\" --auto-approve\n  echo 'Atlas migrations completed successfully'\nelse\n  echo 'No migrations found'\nfi\nwait $$MYSQL_PID\n"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "MYSQL_PWD=\"$${MYSQL_PASSWORD}\" mysql -h 127.0.0.1 -u \"$${MYSQL_USER}\" \"$${MYSQL_DATABASE}\" -e \"SELECT 1\" >/dev/null"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "start_period": "60s"
      },
      "networks": [
        "coze-network"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "1536m",
      "pull_policy": "never"
    },
    "redis": {
      "image": "bitnamilegacy/redis@sha256:5927ff3702df7106bbb7dcc0f8e3d053d979253c3aecce53f07f40db990f823b",
      "container_name": "coze-redis",
      "restart": "unless-stopped",
      "user": "root",
      "privileged": true,
      "env_file": [
        ".env"
      ],
      "environment": [
        "REDIS_AOF_ENABLED=${REDIS_AOF_ENABLED:-no}",
        "REDIS_PORT_NUMBER=${REDIS_PORT_NUMBER:-6379}",
        "REDIS_IO_THREADS=${REDIS_IO_THREADS:-4}",
        "ALLOW_EMPTY_PASSWORD=${ALLOW_EMPTY_PASSWORD:-yes}"
      ],
      "volumes": [
        "/home/coze/data/bitnami/redis:/bitnami/redis/data:rw,z"
      ],
      "command": "bash -c \"\n  /opt/bitnami/scripts/redis/setup.sh\n  # Set proper permissions for data directories\n  chown -R redis:redis /bitnami/redis/data\n  chmod g+s /bitnami/redis/data\n\n  exec /opt/bitnami/scripts/redis/entrypoint.sh /opt/bitnami/scripts/redis/run.sh\n\"\n",
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": "5s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "10s"
      },
      "networks": [
        "coze-network"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "512m",
      "pull_policy": "never"
    },
    "elasticsearch": {
      "image": "bitnamilegacy/elasticsearch@sha256:4a7d14222c876a87c1ddd38e1128d8e42df80071b09ec54db5c32586c9cf5a38",
      "container_name": "coze-elasticsearch",
      "restart": "unless-stopped",
      "user": "root",
      "privileged": true,
      "env_file": [
        ".env"
      ],
      "environment": [
        "TEST=1",
        "ES_JAVA_OPTS=-Xms512m -Xmx1024m"
      ],
      "volumes": [
        "/home/coze/data/bitnami/elasticsearch:/bitnami/elasticsearch/data:z",
        "/home/coze/src/coze-studio/docker/volumes/elasticsearch/elasticsearch.yml:/opt/bitnami/elasticsearch/config/my_elasticsearch.yml:z",
        "/home/coze/src/coze-studio/docker/volumes/elasticsearch/analysis-smartcn.zip:/opt/bitnami/elasticsearch/analysis-smartcn.zip:rw,z",
        "/home/coze/src/coze-studio/docker/volumes/elasticsearch/setup_es.sh:/setup_es.sh:z",
        "/home/coze/src/coze-studio/docker/volumes/elasticsearch/es_index_schema:/es_index_schema:z"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -f http://localhost:9200 && [ -f /tmp/es_plugins_ready ] && [ -f /tmp/es_init_complete ]"
        ],
        "interval": "5s",
        "timeout": "10s",
        "retries": 30,
        "start_period": "120s"
      },
      "networks": [
        "coze-network"
      ],
      "command": "bash -c \"\n  /opt/bitnami/scripts/elasticsearch/setup.sh\n  # Set proper permissions for data directories\n  chown -R elasticsearch:elasticsearch /bitnami/elasticsearch/data\n  chmod g+s /bitnami/elasticsearch/data\n\n  # Create plugin directory\n  mkdir -p /bitnami/elasticsearch/plugins;\n\n  # Unzip plugin to plugin directory and set correct permissions\n  echo 'Installing smartcn plugin...';\n  if [ ! -d /opt/bitnami/elasticsearch/plugins/analysis-smartcn ]; then\n\n    # Download plugin package locally\n    echo 'Copying smartcn plugin...';\n    cp /opt/bitnami/elasticsearch/analysis-smartcn.zip /tmp/analysis-smartcn.zip\n\n    elasticsearch-plugin install file:///tmp/analysis-smartcn.zip\n    if [[ \"$$?\" != \"0\" ]]; then\n      echo 'Plugin installation failed, exiting operation';\n      rm -rf /opt/bitnami/elasticsearch/plugins/analysis-smartcn\n      exit 1;\n    fi;\n    rm -f /tmp/analysis-smartcn.zip;\n  fi;\n\n  # Create marker file indicating plugin installation success\n  touch /tmp/es_plugins_ready;\n  echo 'Plugin installation successful, marker file created';\n\n  # Start initialization script in background\n  (\n    echo 'Waiting for Elasticsearch to be ready...'\n    until curl -s -f http://localhost:9200/_cat/health >/dev/null 2>&1; do\n      echo 'Elasticsearch not ready, waiting...'\n      sleep 2\n    done\n    echo 'Elasticsearch is ready!'\n\n    # Run ES initialization script\n    echo 'Running Elasticsearch initialization...'\n    sed 's/\\r$$//' /setup_es.sh > /setup_es_fixed.sh\n    chmod +x /setup_es_fixed.sh\n    /setup_es_fixed.sh --index-dir /es_index_schema\n    # Create marker file indicating initialization completion\n    touch /tmp/es_init_complete\n    echo 'Elasticsearch initialization completed successfully!'\n  ) &\n\n  # Start Elasticsearch\n  exec /opt/bitnami/scripts/elasticsearch/entrypoint.sh /opt/bitnami/scripts/elasticsearch/run.sh\n  echo -e \"\u23f3 Adjusting Elasticsearch disk watermark settings...\"\n\"\n",
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "2g",
      "pull_policy": "never"
    },
    "minio": {
      "image": "coze-local/minio:2025-06-13",
      "container_name": "coze-minio",
      "user": "root",
      "privileged": true,
      "restart": "unless-stopped",
      "env_file": [
        ".env"
      ],
      "volumes": [
        "/home/coze/data/minio:/data:z",
        "/home/coze/src/coze-studio/docker/volumes/minio/default_icon:/default_icon:z",
        "/home/coze/src/coze-studio/docker/volumes/minio/official_plugin_icon:/official_plugin_icon:z"
      ],
      "environment": {
        "MINIO_ROOT_USER": "${MINIO_ROOT_USER:-minioadmin}",
        "MINIO_ROOT_PASSWORD": "${MINIO_ROOT_PASSWORD:-minioadmin123}",
        "MINIO_DEFAULT_BUCKETS": "${STORAGE_BUCKET:-opencoze},${MINIO_DEFAULT_BUCKETS:-milvus}"
      },
      "entrypoint": [
        "/bin/sh",
        "-c",
        "# Run initialization in background\n(\n  # Wait for MinIO to be ready\n  until (/usr/bin/mc alias set localminio http://localhost:9000 $${MINIO_ROOT_USER} $${MINIO_ROOT_PASSWORD}) do\n    echo \"Waiting for MinIO to be ready...\"\n    sleep 1\n  done\n\n  # Create bucket and copy files\n  /usr/bin/mc mb --ignore-existing localminio/$${STORAGE_BUCKET}\n  /usr/bin/mc cp --recursive /default_icon/ localminio/$${STORAGE_BUCKET}/default_icon/\n  /usr/bin/mc cp --recursive /official_plugin_icon/ localminio/$${STORAGE_BUCKET}/official_plugin_icon/\n\n  echo \"MinIO initialization complete.\"\n) &\n\n# Start minio server in foreground\nexec minio server /data --console-address \":9001\"\n"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/usr/bin/mc alias set health_check http://localhost:9000 ${MINIO_ROOT_USER} ${MINIO_ROOT_PASSWORD} && /usr/bin/mc ready health_check"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "30s"
      },
      "networks": [
        "coze-network"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "1g",
      "pull_policy": "never"
    },
    "etcd": {
      "image": "bitnamilegacy/etcd@sha256:1b9977cf4cce7546873e0ee50e684c38a38a4e7a27d22086fbd2b8a1b44a69d0",
      "container_name": "coze-etcd",
      "user": "root",
      "restart": "unless-stopped",
      "privileged": true,
      "env_file": [
        ".env"
      ],
      "environment": [
        "ETCD_AUTO_COMPACTION_MODE=revision",
        "ETCD_AUTO_COMPACTION_RETENTION=1000",
        "ETCD_QUOTA_BACKEND_BYTES=4294967296",
        "ALLOW_NONE_AUTHENTICATION=yes"
      ],
      "volumes": [
        "/home/coze/data/bitnami/etcd:/bitnami/etcd:rw,z",
        "/home/coze/src/coze-studio/docker/volumes/etcd/etcd.conf.yml:/opt/bitnami/etcd/conf/etcd.conf.yml:ro,z"
      ],
      "command": "bash -c \"\n  /opt/bitnami/scripts/etcd/setup.sh\n  # Set proper permissions for data and config directories\n  chown -R etcd:etcd /bitnami/etcd\n  chmod g+s /bitnami/etcd\n\n  exec /opt/bitnami/scripts/etcd/entrypoint.sh /opt/bitnami/scripts/etcd/run.sh\n\"\n",
      "healthcheck": {
        "test": [
          "CMD",
          "etcdctl",
          "endpoint",
          "health"
        ],
        "interval": "5s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "10s"
      },
      "networks": [
        "coze-network"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "512m",
      "pull_policy": "never"
    },
    "milvus": {
      "container_name": "coze-milvus",
      "image": "milvusdb/milvus@sha256:02e1d60d71ab60f435c60076f4fed2abe59602ecd5e18dcfe229c8c558c4379d",
      "user": "root",
      "privileged": true,
      "restart": "unless-stopped",
      "env_file": [
        ".env"
      ],
      "command": "bash -c \"\n  # Set proper permissions for data directories\n  chown -R root:root /var/lib/milvus\n  chmod g+s /var/lib/milvus\n\n  exec milvus run standalone\n\"\n",
      "security_opt": [
        "seccomp:unconfined"
      ],
      "environment": {
        "ETCD_ENDPOINTS": "etcd:2379",
        "MINIO_ADDRESS": "minio:9000",
        "MINIO_BUCKET_NAME": "${MINIO_DEFAULT_BUCKETS:-milvus}",
        "MINIO_ACCESS_KEY_ID": "${MINIO_ROOT_USER:-minioadmin}",
        "MINIO_SECRET_ACCESS_KEY": "${MINIO_ROOT_PASSWORD:-minioadmin123}",
        "MINIO_USE_SSL": false,
        "LOG_LEVEL": "debug"
      },
      "volumes": [
        "/home/coze/data/milvus:/var/lib/milvus:rw,z"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:9091/healthz"
        ],
        "interval": "5s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "10s"
      },
      "depends_on": {
        "etcd": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "coze-network"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "4g",
      "pull_policy": "never"
    },
    "nsqlookupd": {
      "image": "nsqio/nsq@sha256:aa1ac075d45fc3dccaafbe180b8dea5421bfc17df7a9699693987ef35b5be4ad",
      "container_name": "coze-nsqlookupd",
      "command": "/nsqlookupd",
      "restart": "unless-stopped",
      "networks": [
        "coze-network"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "nsqlookupd --version"
        ],
        "interval": "5s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "10s"
      },
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "128m",
      "volumes": [],
      "pull_policy": "never"
    },
    "nsqd": {
      "image": "nsqio/nsq@sha256:aa1ac075d45fc3dccaafbe180b8dea5421bfc17df7a9699693987ef35b5be4ad",
      "container_name": "coze-nsqd",
      "command": "/nsqd --lookupd-tcp-address=nsqlookupd:4160 --broadcast-address=nsqd --data-path=/data --max-bytes-per-file=104857600 --msg-timeout=120s --max-msg-timeout=24h",
      "restart": "unless-stopped",
      "depends_on": {
        "nsqlookupd": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "coze-network"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/nsqd --version"
        ],
        "interval": "5s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "10s"
      },
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "256m",
      "volumes": [
        "/home/coze/data/nsq:/data:rw,z"
      ],
      "pull_policy": "never"
    },
    "nsqadmin": {
      "image": "nsqio/nsq@sha256:aa1ac075d45fc3dccaafbe180b8dea5421bfc17df7a9699693987ef35b5be4ad",
      "container_name": "coze-nsqadmin",
      "command": "/nsqadmin --lookupd-http-address=nsqlookupd:4161",
      "restart": "unless-stopped",
      "depends_on": {
        "nsqlookupd": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "coze-network"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "128m",
      "volumes": [],
      "pull_policy": "never"
    },
    "coze-server": {
      "image": "coze-local/server:plugins-ec78c0f3a369",
      "restart": "unless-stopped",
      "container_name": "coze-server",
      "env_file": [
        ".env"
      ],
      "networks": [
        "coze-network"
      ],
      "volumes": [
        "/home/coze/src/coze-studio/docker/.env:/app/.env:z",
        "/home/coze/src/coze-studio/backend/conf:/app/resources/conf:z",
        "/home/coze/secrets/plugin-credential.key:/run/secrets/coze-plugin-credentials.key:ro,z"
      ],
      "depends_on": {
        "mysql": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        },
        "elasticsearch": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        },
        "milvus": {
          "condition": "service_healthy"
        }
      },
      "command": [
        "/app/opencoze"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "2g",
      "pull_policy": "never",
      "environment": {
        "COZE_ADDRESS_DOCUMENT_IDS": "7706726398408261632",
        "PLUGIN_CREDENTIAL_KEY_FILE": "/run/secrets/coze-plugin-credentials.key"
      }
    },
    "coze-web": {
      "image": "cozedev/coze-studio-web@sha256:a137a16ab75b871b08911ca87359fc8981b225b63b94cf3e0979069fbd862aea",
      "container_name": "coze-web",
      "restart": "unless-stopped",
      "ports": [
        "${WEB_LISTEN_ADDR:-8888}:80"
      ],
      "volumes": [
        "/home/coze/src/coze-studio/docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro,z",
        "/home/coze/src/coze-studio/docker/nginx/conf.d/default.conf:/etc/nginx/conf.d/default.conf:ro,z",
        "/home/coze/releases/web-agent-ea214b060c09:/usr/share/nginx/html:ro,z",
        "/home/coze/src/coze-studio/backend/conf/admin/app-base-path.js:/etc/nginx/coze-app-base-path.js:ro,z"
      ],
      "depends_on": [
        "coze-server"
      ],
      "networks": [
        "coze-network"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      },
      "mem_limit": "256m",
      "pull_policy": "never"
    }
  },
  "networks": {
    "coze-network": {
      "driver": "bridge"
    }
  }
}
