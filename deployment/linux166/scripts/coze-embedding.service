[Unit]
Description=Coze local embedding service
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/home/coze/embedding
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=coze-embedding
Group=coze-embedding
WorkingDirectory=/home/coze/embedding/models
Environment=HOME=/home/coze/embedding/models
Environment=OLLAMA_HOST=172.18.0.1:11434
Environment=OLLAMA_MODELS=/home/coze/embedding/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=32
Environment=OLLAMA_KEEP_ALIVE=10m
Environment=OLLAMA_CONTEXT_LENGTH=8192
Environment=OLLAMA_NO_CLOUD=1
Environment=GOMAXPROCS=8
ExecStart=/home/coze/embedding/runtime/bin/ollama serve
Restart=on-failure
RestartSec=5
CPUQuota=800%
MemoryHigh=5G
MemoryMax=6G
TasksMax=512
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/coze/embedding/models
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressAllow=192.168.1.166/32
IPAddressAllow=172.18.0.0/16

[Install]
WantedBy=multi-user.target
